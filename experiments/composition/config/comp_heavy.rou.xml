    <flow id="f_car_S_W" type="car_standard"    from="south_in" to="west_out"  begin="0" end="3600" vehsPerHour="8.8"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_bus_S_W" type="bus_city"         from="south_in" to="west_out"  begin="0" end="3600" vehsPerHour="8.8"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_trk_S_W" type="truck_light"      from="south_in" to="west_out"  begin="0" end="3600" vehsPerHour="11.0" departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_van_S_W" type="delivery_van"     from="south_in" to="west_out"  begin="0" end="3600" vehsPerHour="6.6"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_gen_S_W" type="vehicle_general"  from="south_in" to="west_out"  begin="0" end="3600" vehsPerHour="2.2"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_coa_S_W" type="coach_long"       from="south_in" to="west_out"  begin="0" end="3600" vehsPerHour="6.6"  departLane="best" departSpeed="max" departPos="free"/>

    <!-- EAST approach -->
    <flow id="f_car_E_W" type="car_standard"    from="east_in"  to="west_out"  begin="0" end="3600" vehsPerHour="10.5" departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_bus_E_W" type="bus_city"         from="east_in"  to="west_out"  begin="0" end="3600" vehsPerHour="10.5" departLane="best" departSpeed="max" departPos="free"/>
