    <!-- WEST approach -->
    <flow id="f_car_W_E" type="car_standard"    from="west_in"  to="east_out"  begin="0" end="3600" vehsPerHour="10.5" departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_bus_W_E" type="bus_city"         from="west_in"  to="east_out"  begin="0" end="3600" vehsPerHour="10.5" departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_trk_W_E" type="truck_light"      from="west_in"  to="east_out"  begin="0" end="3600" vehsPerHour="13.1" departLane="best" departSpeed="max" departPos="free"/>
