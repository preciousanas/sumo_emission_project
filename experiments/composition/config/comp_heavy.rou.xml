    <flow id="f_car_E_N" type="car_standard"    from="east_in"  to="north_out" begin="0" end="3600" vehsPerHour="9.1"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_bus_E_N" type="bus_city"         from="east_in"  to="north_out" begin="0" end="3600" vehsPerHour="9.1"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_trk_E_N" type="truck_light"      from="east_in"  to="north_out" begin="0" end="3600" vehsPerHour="11.4" departLane="best" departSpeed="max" departPos="free"/>
