    <flow id="f_trk_S_N" type="truck_light"      from="south_in" to="north_out" begin="0" end="3600" vehsPerHour="13.1" departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_van_S_N" type="delivery_van"     from="south_in" to="north_out" begin="0" end="3600" vehsPerHour="7.9"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_gen_S_N" type="vehicle_general"  from="south_in" to="north_out" begin="0" end="3600" vehsPerHour="2.6"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_coa_S_N" type="coach_long"       from="south_in" to="north_out" begin="0" end="3600" vehsPerHour="7.9"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_car_S_E" type="car_standard"    from="south_in" to="east_out"  begin="0" end="3600" vehsPerHour="9.1"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_bus_S_E" type="bus_city"         from="south_in" to="east_out"  begin="0" end="3600" vehsPerHour="9.1"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_trk_S_E" type="truck_light"      from="south_in" to="east_out"  begin="0" end="3600" vehsPerHour="11.4" departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_van_S_E" type="delivery_van"     from="south_in" to="east_out"  begin="0" end="3600" vehsPerHour="6.8"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_gen_S_E" type="vehicle_general"  from="south_in" to="east_out"  begin="0" end="3600" vehsPerHour="2.3"  departLane="best" departSpeed="max" departPos="free"/>
