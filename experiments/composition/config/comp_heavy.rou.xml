    <flow id="f_gen_E_N" type="vehicle_general"  from="east_in"  to="north_out" begin="0" end="3600" vehsPerHour="2.3"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_coa_E_N" type="coach_long"       from="east_in"  to="north_out" begin="0" end="3600" vehsPerHour="6.8"  departLane="best" departSpeed="max" departPos="free"/>
    <flow id="f_car_E_S" type="car_standard"    from="east_in"  to="south_out" begin="0" end="3600" vehsPerHour="8.8"  departLane="best" departSpeed="max" departPos="free"/>
