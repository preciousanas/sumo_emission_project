    <!--   bus_city:        15% × 142 = 21.3 veh/hr per approach         -->
    <!--   truck_light:     15% × 142 = 21.3 veh/hr per approach         -->
    <!--   delivery_van:    10% × 142 = 14.2 veh/hr per approach         -->
    <!--   vehicle_general: 10% × 142 = 14.2 veh/hr per approach         -->
    <!--   coach_long:      10% × 142 = 14.2 veh/hr per approach         -->
    <!--                                                                  -->
    <!-- Route split (3 turns per approach, approximately equal):         -->
    <!--   straight: ~37% of veh/hr per approach (most common)           -->
    <!--   left:     ~32% of veh/hr per approach                         -->
    <!--   right:    ~31% of veh/hr per approach                         -->
    <!-- ================================================================ -->

    <!-- ============================================================ -->
    <!-- NORTH approach (from="north_in")                             -->
    <!-- ============================================================ -->

    <!-- Straight: north → south -->
    <flow id="f_car_N_S"   type="car_standard"   from="north_in" to="south_out" begin="0" end="3600" vehsPerHour="21.0" departLane="best" departSpeed="max" departPos="free" />
    <flow id="f_bus_N_S"   type="bus_city"        from="north_in" to="south_out" begin="0" end="3600" vehsPerHour="7.9"  departLane="best" departSpeed="max" departPos="free" />
