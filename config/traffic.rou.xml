<!-- 
    traffic.rou.xml
    ====================
    Flow-based route file for SUMO intersection capacity and scenario analysis.

    VEHICLE MIX:
      car_standard:   40%
      bus_city:       15%
      truck_light:    15%
      delivery_van:   10%
      vehicle_general:10%
      coach_long:     10%

    TARGET V/C → TOTAL vehsPerHour TABLE:
      V/C ~ 20% (LOS A)  → total = 568 veh/hr  → use scale = 1.0 (default below)
      V/C ~ 40% (LOS A-B)→ total = 1136 veh/hr → use scale = 2.0
      V/C ~ 60% (LOS C)  → total = 1704 veh/hr → use scale = 3.0
      V/C ~ 80% (LOS D)  → total = 2272 veh/hr → use scale = 4.0
      V/C ~100% (LOS E)  → total = 2840 veh/hr → use scale = 5.0

    DEFAULT BELOW = 568 veh/hr total (≈ 20% V/C, LOS A).
    Each approach gets 142 veh/hr total, split by vehicle mix.

    ROUTES (12 origin-destination pairs, matching original file):
      north→south, north→east, north→west
      south→north, south→east, south→west
      east→west,   east→north, east→south
      west→east,   west→north, west→south

-->


<routes>

    <!-- ================================================================ -->
    <!-- VEHICLE TYPE DEFINITIONS (identical to original traffic_rou.xml) -->
    <!-- ================================================================ -->

    <vType id="car_standard"   emissionClass="HBEFA3/PC_G_EU4" maxSpeed="30" />
    <vType id="bus_city"       emissionClass="HBEFA3/Bus"       maxSpeed="20" />
    <vType id="truck_light"    emissionClass="HBEFA3/HDV"       maxSpeed="25" />
    <vType id="delivery_van"   emissionClass="HBEFA3/LDV"       maxSpeed="22" />
    <vType id="vehicle_general" emissionClass="HBEFA3/PC_G_EU4" maxSpeed="28" />
    <vType id="coach_long"     emissionClass="HBEFA3/Coach"     maxSpeed="18" />

    <!-- ================================================================ -->
    <!-- FLOWS                                                            -->
    <!--                                                                  -->
    <!-- Total per approach = 142 veh/hr (= 568/4 approaches)            -->
    <!-- Split by vehicle mix:                                            -->
