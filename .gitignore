build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.hypothesis/
.tox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

